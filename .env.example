# ---------------------------------------------------------------------------
# ZELVATION REGISTRATION PORTAL — environment template
# Copy to `.env.local` for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (shared project, isolated `zelvation` schema) ------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never import into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site -------------------------------------------------------------------
# Used for absolute links, email logo, PDF logo and CORS on Edge Functions.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Payment provider selection --------------------------------------------
# razorpay | icici   (ICICI requires merchant onboarding; see docs/PAYMENT-PROVIDERS.md)
NEXT_PUBLIC_PAYMENT_PROVIDER=razorpay

# --- Razorpay (server-side only) -------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Dynamic UPI QR per order — the PRIMARY payment path for this deployment.
# Requires the "upi_qr" feature to be activated on the Razorpay account
# (it is an on-demand feature: raise a request with Razorpay support).
# Set to false and the checkout page alone is offered.
RAZORPAY_ENABLE_UPI_QR=true

# --- ICICI Bank merchant gateway (server-side only, when approved) ----------
# Leave blank until ICICI provides merchant credentials and the API contract.
ICICI_MERCHANT_ID=
ICICI_API_KEY=
ICICI_API_SECRET=
ICICI_BASE_URL=
ICICI_WEBHOOK_SECRET=

# --- Resend (transactional email, server-side only) ------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Zelvation <registrations@your-verified-domain.com>

# --- Supabase Edge Function secrets ---------------------------------------
# The functions read the SAME names above from `supabase secrets set`.
# Set them with:
#   supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... \
#     RAZORPAY_WEBHOOK_SECRET=... RESEND_API_KEY=... RESEND_FROM_EMAIL=... \
#     SITE_URL=... SUPABASE_ANON_KEY=...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
